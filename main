-- ═══════════════════════════════════════════════════
--  UTILITAIRES INTERNES
-- ═══════════════════════════════════════════════════

-- Crée une Instance Roblox avec ses propriétés d'un coup
local function New(class, props)
    local obj = Instance.new(class)
    for k, v in pairs(props) do
        if k ~= "Parent" then obj[k] = v end
    end
    if props.Parent then obj.Parent = props.Parent end
    return obj
end

-- Anime avec TweenService
local function Tween(obj, goal, duration, style)
    TweenService:Create(obj,
        TweenInfo.new(
            duration or 0.16,
            style    or Enum.EasingStyle.Quad,
            Enum.EasingDirection.Out
        ),
        goal
    ):Play()
end

-- Arrondi
local function Corner(parent, radius)
    return New("UICorner", {
        CornerRadius = UDim.new(0, radius or 8),
        Parent       = parent,
    })
end

-- Bordure
local function Stroke(parent, color, thickness)
    return New("UIStroke", {
        Color     = color     or T.Border,
        Thickness = thickness or 1,
        Parent    = parent,
    })
end

-- ═══════════════════════════════════════════════════
--  CLASSE : GroupBox
--  Un container titré dans un Tab.
-- ═══════════════════════════════════════════════════
local GroupBox = {}
GroupBox.__index = GroupBox

function GroupBox._new(scrollParent, name)
    local self = setmetatable({}, GroupBox)

    -- Wrapper qui grandit automatiquement
    local wrap = New("Frame", {
        Name          = "GB_" .. name,
        Size          = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = T.GroupBG,
        BorderSizePixel  = 0,
        ZIndex           = 3,
        Parent           = scrollParent,
    })
    Corner(wrap, 9)
    Stroke(wrap, T.GroupBorder, 1)

    -- En-tête du GroupBox
    local head = New("Frame", {
        Name             = "Head",
        Size             = UDim2.new(1, 0, 0, 30),
        BackgroundColor3 = T.GroupHead,
        BorderSizePixel  = 0,
        ZIndex           = 4,
        Parent           = wrap,
    })
    Corner(head, 9)
    -- Aplanir les coins bas de l'en-tête
    New("Frame", {
        Size             = UDim2.new(1, 0, 0, 9),
        Position         = UDim2.new(0, 0, 1, -9),
        BackgroundColor3 = T.GroupHead,
        BorderSizePixel  = 0,
        ZIndex           = 4,
        Parent           = head,
    })

    New("TextLabel", {
        Size                   = UDim2.new(1, -16, 1, 0),
        Position               = UDim2.new(0, 12, 0, 0),
        BackgroundTransparency = 1,
        Text                   = name,
        TextColor3             = T.Text,
        TextSize               = 12,
        Font                   = Enum.Font.GothamBold,
        TextXAlignment         = Enum.TextXAlignment.Left,
        ZIndex                 = 5,
        Parent                 = head,
    })

    -- Séparateur
    New("Frame", {
        Size             = UDim2.new(1, 0, 0, 1),
        Position         = UDim2.new(0, 0, 0, 30),
        BackgroundColor3 = T.GroupBorder,
        BorderSizePixel  = 0,
        ZIndex           = 4,
        Parent           = wrap,
    })

    -- Zone de contenu (les éléments atterriront ici)
    local body = New("Frame", {
        Name             = "Body",
        Size             = UDim2.new(1, 0, 0, 0),
        Position         = UDim2.new(0, 0, 0, 31),
        AutomaticSize    = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        BorderSizePixel  = 0,
        ZIndex           = 4,
        Parent           = wrap,
    })
    New("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding   = UDim.new(0, 6),
        Parent    = body,
    })
    New("UIPadding", {
        PaddingTop    = UDim.new(0, 10),
        PaddingBottom = UDim.new(0, 10),
        PaddingLeft   = UDim.new(0, 10),
        PaddingRight  = UDim.new(0, 10),
        Parent        = body,
    })

    self._body = body
    self._wrap = wrap
    return self
end

-- ═══════════════════════════════════════════════════
--  CLASSE : Tab
--  Un onglet dans la sidebar + sa page de contenu.
-- ═══════════════════════════════════════════════════
local Tab = {}
Tab.__index = Tab

function Tab._new(navFrame, contentFrame, name, icon, layoutOrder)
    local self = setmetatable({}, Tab)

    -- ── Bouton de navigation ──────────────────
    local btn = New("TextButton", {
        Name             = "TabBtn_" .. name,
        Size             = UDim2.new(1, 0, 0, 32),
        BackgroundColor3 = T.Accent,
        BackgroundTransparency = 1,
        Text             = "",
        BorderSizePixel  = 0,
        AutoButtonColor  = false,
        LayoutOrder      = layoutOrder,
        ZIndex           = 3,
        Parent           = navFrame,
    })
    Corner(btn, 7)

    -- Icône optionnelle
    local textOffsetX = 10
    if icon then
        New("ImageLabel", {
            Size                   = UDim2.fromOffset(15, 15),
            Position               = UDim2.new(0, 10, 0.5, -7),
            BackgroundTransparency = 1,
            Image                  = "rbxassetid://" .. tostring(icon),
            ImageColor3            = T.Muted,
            ZIndex                 = 4,
            Parent                 = btn,
        })
        textOffsetX = 30
    end

    local lbl = New("TextLabel", {
        Size                   = UDim2.new(1, -(textOffsetX + 8), 1, 0),
        Position               = UDim2.new(0, textOffsetX, 0, 0),
        BackgroundTransparency = 1,
        Text                   = name,
        TextColor3             = T.Muted,
        TextSize               = 12,
        Font                   = Enum.Font.Gotham,
        TextXAlignment         = Enum.TextXAlignment.Left,
        ZIndex                 = 4,
        Parent                 = btn,
    })

    -- ── Page de contenu ───────────────────────
    local scroll = New("ScrollingFrame", {
        Name                 = "Page_" .. name,
        Size                 = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel      = 0,
        ScrollBarThickness   = 3,
        ScrollBarImageColor3 = T.ScrollBar,
        CanvasSize           = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize  = Enum.AutomaticSize.Y,
        Visible              = false,
        ZIndex               = 2,
        Parent               = contentFrame,
    })
    New("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding   = UDim.new(0, 10),
        Parent    = scroll,
    })
    New("UIPadding", {
        PaddingTop    = UDim.new(0, 14),
        PaddingBottom = UDim.new(0, 14),
        PaddingLeft   = UDim.new(0, 14),
        PaddingRight  = UDim.new(0, 14),
        Parent        = scroll,
    })

    self._btn    = btn
    self._lbl    = lbl
    self._scroll = scroll
    return self
end

-- Active visuellement ce tab
function Tab:_Select()
    self._scroll.Visible = true
    Tween(self._btn, { BackgroundTransparency = 0 }, 0.14)
    self._lbl.Font       = Enum.Font.GothamBold
    self._lbl.TextColor3 = T.Text
end

-- Désactive visuellement ce tab
function Tab:_Deselect()
    self._scroll.Visible = false
    Tween(self._btn, { BackgroundTransparency = 1 }, 0.14)
    self._lbl.Font       = Enum.Font.Gotham
    self._lbl.TextColor3 = T.Muted
end

-- Crée un GroupBox dans ce tab
function Tab:AddGroupBox(name)
    return GroupBox._new(self._scroll, name)
end

-- ═══════════════════════════════════════════════════
--  CLASSE : Section
--  Un groupe d'onglets dans la sidebar.
-- ═══════════════════════════════════════════════════
local Section = {}
Section.__index = Section

function Section._new(navFrame, contentFrame, window, name, baseOrder)
    local self = setmetatable({}, Section)

    self._navFrame     = navFrame
    self._contentFrame = contentFrame
    self._window       = window
    self._baseOrder    = baseOrder
    self._tabCount     = 0

    -- Label de section (ex: "PRINCIPAL")
    local lbl = New("TextLabel", {
        Name                   = "Sec_" .. name,
        Size                   = UDim2.new(1, 0, 0, 26),
        BackgroundTransparency = 1,
        Text                   = string.upper(name),
        TextColor3             = T.Label,
        TextSize               = 10,
        Font                   = Enum.Font.GothamBold,
        TextXAlignment         = Enum.TextXAlignment.Left,
        LayoutOrder            = baseOrder,
        ZIndex                 = 3,
        Parent                 = navFrame,
    })
    New("UIPadding", {
        PaddingLeft = UDim.new(0, 8),
        PaddingTop  = UDim.new(0, 4),
        Parent      = lbl,
    })

    return self
end

-- Ajoute un onglet dans cette section
function Section:AddTab(name, icon)
    self._tabCount = self._tabCount + 1
    local order    = self._baseOrder + self._tabCount

    local tab = Tab._new(
        self._navFrame,
        self._contentFrame,
        name,
        icon,
        order
    )

    local win = self._window

    -- Clic sur le bouton de nav
    tab._btn.MouseButton1Click:Connect(function()
        win:_SelectTab(tab)
    end)
    -- Hover
    tab._btn.MouseEnter:Connect(function()
        if win._currentTab ~= tab then
            Tween(tab._btn, { BackgroundTransparency = 0.88 }, 0.12)
        end
    end)
    tab._btn.MouseLeave:Connect(function()
        if win._currentTab ~= tab then
            Tween(tab._btn, { BackgroundTransparency = 1 }, 0.12)
        end
    end)

    -- Sélection automatique du tout premier tab créé
    win._tabCount = (win._tabCount or 0) + 1
    if win._tabCount == 1 then
        win:_SelectTab(tab)
    end

    return tab
end

-- ═══════════════════════════════════════════════════
--  CLASSE : Window
--  La fenêtre principale.
-- ═══════════════════════════════════════════════════
local Window = {}
Window.__index = Window

-- Constantes de mise en page
local SIDEBAR_W = 170
local WIN_W     = 720
local WIN_H     = 460

function Window._new(config)
    local self = setmetatable({}, Window)

    self._config       = config
    self._sectionCount = 0
    self._tabCount     = 0
    self._currentTab   = nil

    -- 1. Construire la fenêtre (cachée)
    self:_BuildWindow()
    -- 2. Construire l'écran de chargement et le jouer
    self:_BuildAndPlayLoading()

    return self
end

-- ── Écran de chargement ─────────────────────────────
function Window:_BuildAndPlayLoading()
    local cfg = self._config.LoadingSettings or {}

    local gui = New("ScreenGui", {
        Name           = "Requiem_Load",
        ResetOnSpawn   = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        Parent         = PlayerGui,
    })

    local bg = New("Frame", {
        Size             = UDim2.fromOffset(WIN_W, WIN_H),
        Position         = UDim2.new(0.5, -WIN_W/2, 0.5, -WIN_H/2),
        BackgroundColor3 = T.LoadBG,
        BorderSizePixel  = 0,
        ZIndex           = 20,
        Parent           = gui,
    })
    Corner(bg, 12)
    Stroke(bg, T.Border, 1)

    -- Titre
    New("TextLabel", {
        Size                   = UDim2.new(1, 0, 0, 36),
        Position               = UDim2.new(0, 0, 0.5, -40),
        BackgroundTransparency = 1,
        Text                   = cfg.Title or self._config.Name or "Script",
        TextColor3             = T.Text,
        TextSize               = 22,
        Font                   = Enum.Font.GothamBold,
        TextXAlignment         = Enum.TextXAlignment.Center,
        ZIndex                 = 21,
        Parent                 = bg,
    })

    -- Sous-titre
    New("TextLabel", {
        Size                   = UDim2.new(1, 0, 0, 20),
        Position               = UDim2.new(0, 0, 0.5, 4),
        BackgroundTransparency = 1,
        Text                   = cfg.Subtitle or "",
        TextColor3             = T.Muted,
        TextSize               = 12,
        Font                   = Enum.Font.Gotham,
        TextXAlignment         = Enum.TextXAlignment.Center,
        ZIndex                 = 21,
        Parent                 = bg,
    })

    -- Barre de progression
    local barBG = New("Frame", {
        Size             = UDim2.fromOffset(220, 3),
        Position         = UDim2.new(0.5, -110, 0.5, 42),
        BackgroundColor3 = T.Border,
        BorderSizePixel  = 0,
        ZIndex           = 21,
        Parent           = bg,
    })
    Corner(barBG, 100)

    local barFill = New("Frame", {
        Size             = UDim2.fromOffset(0, 3),
        BackgroundColor3 = T.Accent,
        BorderSizePixel  = 0,
        ZIndex           = 22,
        Parent           = barBG,
    })
    Corner(barFill, 100)

    -- Animation de la barre puis transition
    Tween(barFill, { Size = UDim2.fromOffset(220, 3) }, 1.3, Enum.EasingStyle.Exponential)

    task.delay(1.4, function()
        -- Fondu de sortie
        Tween(bg, { BackgroundTransparency = 1 }, 0.35)
        for _, v in ipairs(bg:GetDescendants()) do
            pcall(function()
                if v:IsA("TextLabel") then
                    Tween(v, { TextTransparency = 1, BackgroundTransparency = 1 }, 0.35)
                elseif v:IsA("Frame") then
                    Tween(v, { BackgroundTransparency = 1 }, 0.35)
                end
            end)
        end

        task.delay(0.4, function()
            gui:Destroy()
            -- Afficher la fenêtre principale avec fondu
            self._win.Visible = true
            self._win.BackgroundTransparency = 1
            Tween(self._win, { BackgroundTransparency = 0 }, 0.28)
        end)
    end)
end

-- ── Construction de la fenêtre ──────────────────────
function Window:_BuildWindow()
    local cfg = self._config

    -- ScreenGui conteneur
    self._gui = New("ScreenGui", {
        Name           = "Requiem_" .. (cfg.Name or "UI"),
        ResetOnSpawn   = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        Parent         = PlayerGui,
    })

    -- Frame principale (invisible au début)
    self._win = New("Frame", {
        Name             = "Window",
        Size             = UDim2.fromOffset(WIN_W, WIN_H),
        Position         = UDim2.new(0.5, -WIN_W/2, 0.5, -WIN_H/2),
        BackgroundColor3 = T.WinBG,
        BorderSizePixel  = 0,
        ClipsDescendants = true,
        Visible          = false,
        ZIndex           = 1,
        Parent           = self._gui,
    })
    Corner(self._win, 12)
    Stroke(self._win, T.Border, 1)

    self:_BuildSidebar(cfg)
    self:_BuildTopBar(cfg)
    self:_BuildContent()
    self:_MakeDraggable()
end

function Window:_BuildSidebar(cfg)
    -- Frame sidebar
    local sidebar = New("Frame", {
        Size             = UDim2.new(0, SIDEBAR_W, 1, 0),
        BackgroundColor3 = T.Sidebar,
        BorderSizePixel  = 0,
        ZIndex           = 2,
        Parent           = self._win,
    })
    Corner(sidebar, 12)
    -- Aplanir les coins droits (côté intérieur)
    New("Frame", {
        Size             = UDim2.new(0, 12, 1, 0),
        Position         = UDim2.new(1, -12, 0, 0),
        BackgroundColor3 = T.Sidebar,
        BorderSizePixel  = 0,
        ZIndex           = 2,
        Parent           = sidebar,
    })

    -- En-tête sidebar : icône + nom du script
    local header = New("Frame", {
        Size             = UDim2.new(1, 0, 0, 50),
        BackgroundTransparency = 1,
        ZIndex           = 3,
        Parent           = sidebar,
    })

    local titleX = 12
    if cfg.Icon then
        local iconWrap = New("Frame", {
            Size             = UDim2.fromOffset(26, 26),
            Position         = UDim2.new(0, 12, 0.5, -13),
            BackgroundColor3 = T.Item,
            BorderSizePixel  = 0,
            ZIndex           = 4,
            Parent           = header,
        })
        Corner(iconWrap, 7)
        New("ImageLabel", {
            Size                   = UDim2.new(1, -6, 1, -6),
            Position               = UDim2.new(0, 3, 0, 3),
            BackgroundTransparency = 1,
            Image                  = "rbxassetid://" .. tostring(cfg.Icon),
            ZIndex                 = 5,
            Parent                 = iconWrap,
        })
        titleX = 44
    end

    New("TextLabel", {
        Size                   = UDim2.new(1, -(titleX + 10), 1, 0),
        Position               = UDim2.new(0, titleX, 0, 0),
        BackgroundTransparency = 1,
        Text                   = cfg.Name or "Script",
        TextColor3             = T.Text,
        TextSize               = 13,
        Font                   = Enum.Font.GothamBold,
        TextXAlignment         = Enum.TextXAlignment.Left,
        ZIndex                 = 4,
        Parent                 = header,
    })

    -- Séparateur sous le header
    New("Frame", {
        Size             = UDim2.new(1, -20, 0, 1),
        Position         = UDim2.new(0, 10, 0, 50),
        BackgroundColor3 = T.Border,
        BorderSizePixel  = 0,
        ZIndex           = 3,
        Parent           = sidebar,
    })

    -- Zone de navigation scrollable
    self._navFrame = New("ScrollingFrame", {
        Size                 = UDim2.new(1, 0, 1, -108),
        Position             = UDim2.new(0, 0, 0, 53),
        BackgroundTransparency = 1,
        BorderSizePixel      = 0,
        ScrollBarThickness   = 2,
        ScrollBarImageColor3 = T.ScrollBar,
        CanvasSize           = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize  = Enum.AutomaticSize.Y,
        ZIndex               = 3,
        Parent               = sidebar,
    })
    New("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding   = UDim.new(0, 1),
        Parent    = self._navFrame,
    })
    New("UIPadding", {
        PaddingLeft  = UDim.new(0, 8),
        PaddingRight = UDim.new(0, 8),
        PaddingTop   = UDim.new(0, 4),
        Parent       = self._navFrame,
    })

    -- Infos utilisateur (bas de la sidebar)
    self:_BuildUserInfo(sidebar)
end

function Window:_BuildUserInfo(sidebar)
    local pl = LocalPlayer

    local frame = New("Frame", {
        Name             = "UserInfo",
        Size             = UDim2.new(1, 0, 0, 50),
        Position         = UDim2.new(0, 0, 1, -50),
        BackgroundTransparency = 1,
        ZIndex           = 3,
        Parent           = sidebar,
    })

    New("Frame", {
        Size             = UDim2.new(1, -20, 0, 1),
        Position         = UDim2.new(0, 10, 0, 0),
        BackgroundColor3 = T.Border,
        BorderSizePixel  = 0,
        ZIndex           = 3,
        Parent           = frame,
    })

    local avBg = New("Frame", {
        Size             = UDim2.fromOffset(30, 30),
        Position         = UDim2.new(0, 12, 0.5, -15),
        BackgroundColor3 = T.Item,
        BorderSizePixel  = 0,
        ZIndex           = 4,
        Parent           = frame,
    })
    Corner(avBg, 100)

    local av = New("ImageLabel", {
        Size                   = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Image = "rbxthumb://type=AvatarHeadShot&id=" .. pl.UserId .. "&w=48&h=48",
        ZIndex = 5,
        Parent = avBg,
    })
    Corner(av, 100)

    New("TextLabel", {
        Size                   = UDim2.new(1, -52, 0, 16),
        Position               = UDim2.new(0, 48, 0.5, -16),
        BackgroundTransparency = 1,
        Text                   = pl.DisplayName,
        TextColor3             = T.Text,
        TextSize               = 11,
        Font                   = Enum.Font.GothamBold,
        TextXAlignment         = Enum.TextXAlignment.Left,
        TextTruncate           = Enum.TextTruncate.AtEnd,
        ZIndex                 = 4,
        Parent                 = frame,
    })
    New("TextLabel", {
        Size                   = UDim2.new(1, -52, 0, 14),
        Position               = UDim2.new(0, 48, 0.5, 2),
        BackgroundTransparency = 1,
        Text                   = "@" .. pl.Name,
        TextColor3             = T.Label,
        TextSize               = 10,
        Font                   = Enum.Font.Gotham,
        TextXAlignment         = Enum.TextXAlignment.Left,
        TextTruncate           = Enum.TextTruncate.AtEnd,
        ZIndex                 = 4,
        Parent                 = frame,
    })
end

function Window:_BuildTopBar(cfg)
    local topBar = New("Frame", {
        Size             = UDim2.new(1, -SIDEBAR_W, 0, 38),
        Position         = UDim2.new(0, SIDEBAR_W, 0, 0),
        BackgroundColor3 = T.TopBar,
        BorderSizePixel  = 0,
        ZIndex           = 2,
        Parent           = self._win,
    })
    -- Arrondir uniquement le coin haut-droit (aligne avec le corner de la fenêtre)
    Corner(topBar, 12)
    -- Aplanir le coin bas-gauche (jonction sidebar) et bas-droit
    New("Frame", {
        Size             = UDim2.new(0, 12, 0, 12),
        Position         = UDim2.new(0, 0, 1, -12),
        BackgroundColor3 = T.TopBar,
        BorderSizePixel  = 0,
        ZIndex           = 2,
        Parent           = topBar,
    })
    New("Frame", {
        Size             = UDim2.new(0, 12, 0, 12),
        Position         = UDim2.new(1, -12, 1, -12),
        BackgroundColor3 = T.TopBar,
        BorderSizePixel  = 0,
        ZIndex           = 2,
        Parent           = topBar,
    })
    -- Aplanir le coin haut-gauche (jonction avec la sidebar)
    New("Frame", {
        Size             = UDim2.new(0, 12, 0, 12),
        BackgroundColor3 = T.TopBar,
        BorderSizePixel  = 0,
        ZIndex           = 2,
        Parent           = topBar,
    })

    -- Sous-titre / version
    New("TextLabel", {
        Size                   = UDim2.new(0, 120, 1, 0),
        Position               = UDim2.new(0, 14, 0, 0),
        BackgroundTransparency = 1,
        Text                   = cfg.Subtitle or "",
        TextColor3             = T.Muted,
        TextSize               = 11,
        Font                   = Enum.Font.Gotham,
        TextXAlignment         = Enum.TextXAlignment.Left,
        ZIndex                 = 3,
        Parent                 = topBar,
    })

    -- ── Bouton réduire (tiret) ─────────────────────
    -- taille : 20×20 | gap entre boutons : 6px | marge droite : 14px
    -- X bord droit à 14px → position X = -(14+20) = -34
    -- Minus bord droit à 14+20+6 = 40px → position X = -(40+20) = -60
    local btnMinimize = New("TextButton", {
        Size             = UDim2.fromOffset(20, 20),
        Position         = UDim2.new(1, -60, 0.5, -10),
        BackgroundColor3 = T.Item,
        Text             = "",
        BorderSizePixel  = 0,
        AutoButtonColor  = false,
        ZIndex           = 4,
        Parent           = topBar,
    })
    Corner(btnMinimize, 5)
    New("ImageLabel", {
        Size                   = UDim2.fromOffset(12, 12),
        Position               = UDim2.new(0.5, -6, 0.5, -6),
        BackgroundTransparency = 1,
        Image                  = ICO_MINUS,
        ImageColor3            = T.Muted,
        ZIndex                 = 5,
        Parent                 = btnMinimize,
    })
    btnMinimize.MouseEnter:Connect(function()
        Tween(btnMinimize, { BackgroundColor3 = T.ItemHover }, 0.12)
    end)
    btnMinimize.MouseLeave:Connect(function()
        Tween(btnMinimize, { BackgroundColor3 = T.Item }, 0.12)
    end)
    btnMinimize.MouseButton1Click:Connect(function()
        self:Toggle()
    end)

    -- ── Bouton fermer (croix) ──────────────────────
    local btnClose = New("TextButton", {
        Size             = UDim2.fromOffset(20, 20),
        Position         = UDim2.new(1, -34, 0.5, -10),
        BackgroundColor3 = T.Item,
        Text             = "",
        BorderSizePixel  = 0,
        AutoButtonColor  = false,
        ZIndex           = 4,
        Parent           = topBar,
    })
    Corner(btnClose, 5)
    New("ImageLabel", {
        Size                   = UDim2.fromOffset(12, 12),
        Position               = UDim2.new(0.5, -6, 0.5, -6),
        BackgroundTransparency = 1,
        Image                  = ICO_X,
        ImageColor3            = T.Muted,
        ZIndex                 = 5,
        Parent                 = btnClose,
    })
    btnClose.MouseEnter:Connect(function()
        Tween(btnClose, { BackgroundColor3 = Color3.fromRGB(200, 55, 55) }, 0.12)
    end)
    btnClose.MouseLeave:Connect(function()
        Tween(btnClose, { BackgroundColor3 = T.Item }, 0.12)
    end)
    btnClose.MouseButton1Click:Connect(function()
        self:_ShowCloseConfirm()
    end)
end

function Window:_BuildContent()
    -- Zone principale de contenu (à droite de la sidebar)
    self._content = New("Frame", {
        Name             = "Content",
        Size             = UDim2.new(1, -SIDEBAR_W, 1, -38),
        Position         = UDim2.new(0, SIDEBAR_W, 0, 38),
        BackgroundColor3 = T.Content,
        BorderSizePixel  = 0,
        ClipsDescendants = true,
        ZIndex           = 1,
        Parent           = self._win,
    })
    Corner(self._content, 12)
    -- Aplanir les coins du haut (jonction avec topbar et sidebar)
    New("Frame", {
        Size             = UDim2.new(0, 12, 0, 12),
        BackgroundColor3 = T.Content,
        BorderSizePixel  = 0,
        Parent           = self._content,
    })
    New("Frame", {
        Size             = UDim2.new(0, 12, 0, 12),
        Position         = UDim2.new(1, -12, 0, 0),
        BackgroundColor3 = T.Content,
        BorderSizePixel  = 0,
        Parent           = self._content,
    })
end

function Window:_MakeDraggable()
    local win = self._win
    local dragging, dragStart, startPos

    win.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging  = true
            dragStart = inp.Position
            startPos  = win.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if dragging and inp.UserInputType == Enum.UserInputType.MouseMovement then
            local d = inp.Position - dragStart
            win.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y
            )
        end
    end)
    UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
end

-- ── Sélection d'un tab ──────────────────────────────
function Window:_SelectTab(tab)
    if self._currentTab then
        self._currentTab:_Deselect()
    end
    self._currentTab = tab
    tab:_Select()
end

-- ═══════════════════════════════════════════════════
--  API PUBLIQUE DE WINDOW
-- ═══════════════════════════════════════════════════

-- Crée une section dans la sidebar
function Window:AddSection(name)
    self._sectionCount = self._sectionCount + 1
    local baseOrder    = self._sectionCount * 100

    return Section._new(
        self._navFrame,
        self._content,
        self,
        name,
        baseOrder
    )
end

-- Définit la touche pour afficher/cacher la fenêtre
function Window:SetToggleKey(key)
    UserInputService.InputBegan:Connect(function(inp, gameProcessed)
        if not gameProcessed and inp.KeyCode == key then
            self:Toggle()
        end
    end)
end

-- Affiche / cache la fenêtre
function Window:Toggle()
    self._win.Visible = not self._win.Visible
end

-- Dialog de confirmation avant fermeture
function Window:_ShowCloseConfirm()
    -- Overlay semi-transparent sur la fenêtre
    local overlay = New("Frame", {
        Size             = UDim2.fromScale(1, 1),
        BackgroundColor3 = Color3.fromRGB(0, 0, 0),
        BackgroundTransparency = 0.45,
        BorderSizePixel  = 0,
        ZIndex           = 20,
        Parent           = self._win,
    })

    -- Card centrale
    local card = New("Frame", {
        Size             = UDim2.fromOffset(300, 140),
        Position         = UDim2.new(0.5, -150, 0.5, -70),
        BackgroundColor3 = T.GroupHead,
        BorderSizePixel  = 0,
        ZIndex           = 21,
        Parent           = overlay,
    })
    Corner(card, 12)
    Stroke(card, T.Border, 1)

    -- Titre
    New("TextLabel", {
        Size                   = UDim2.new(1, -24, 0, 36),
        Position               = UDim2.new(0, 12, 0, 12),
        BackgroundTransparency = 1,
        Text                   = "Fermer le script ?",
        TextColor3             = T.Text,
        TextSize               = 14,
        Font                   = Enum.Font.GothamBold,
        TextXAlignment         = Enum.TextXAlignment.Left,
        ZIndex                 = 22,
        Parent                 = card,
    })

    -- Sous-texte
    New("TextLabel", {
        Size                   = UDim2.new(1, -24, 0, 24),
        Position               = UDim2.new(0, 12, 0, 46),
        BackgroundTransparency = 1,
        Text                   = "Cette action supprimera l'interface.",
        TextColor3             = T.Muted,
        TextSize               = 11,
        Font                   = Enum.Font.Gotham,
        TextXAlignment         = Enum.TextXAlignment.Left,
        ZIndex                 = 22,
        Parent                 = card,
    })

    -- Séparateur
    New("Frame", {
        Size             = UDim2.new(1, 0, 0, 1),
        Position         = UDim2.new(0, 0, 0, 80),
        BackgroundColor3 = T.Border,
        BorderSizePixel  = 0,
        ZIndex           = 22,
        Parent           = card,
    })

    -- Bouton Annuler
    local btnCancel = New("TextButton", {
        Size             = UDim2.new(0.5, -1, 0, 40),
        Position         = UDim2.new(0, 0, 0, 81),
        BackgroundColor3 = T.GroupHead,
        BackgroundTransparency = 1,
        Text             = "Annuler",
        TextColor3       = T.Muted,
        TextSize         = 12,
        Font             = Enum.Font.Gotham,
        AutoButtonColor  = false,
        BorderSizePixel  = 0,
        ZIndex           = 23,
        Parent           = card,
    })
    New("UICorner", { CornerRadius = UDim.new(0, 12), Parent = btnCancel })
    -- Aplanir les coins du haut du bouton Annuler
    New("Frame", {
        Size             = UDim2.new(1, 0, 0, 12),
        BackgroundColor3 = T.GroupHead,
        BackgroundTransparency = 1,
        BorderSizePixel  = 0,
        ZIndex           = 22,
        Parent           = btnCancel,
    })

    -- Séparateur vertical entre les deux boutons
    New("Frame", {
        Size             = UDim2.new(0, 1, 0, 40),
        Position         = UDim2.new(0.5, 0, 0, 81),
        BackgroundColor3 = T.Border,
        BorderSizePixel  = 0,
        ZIndex           = 22,
        Parent           = card,
    })

    -- Bouton Fermer
    local btnConfirm = New("TextButton", {
        Size             = UDim2.new(0.5, -1, 0, 40),
        Position         = UDim2.new(0.5, 1, 0, 81),
        BackgroundColor3 = T.GroupHead,
        BackgroundTransparency = 1,
        Text             = "Fermer",
        TextColor3       = Color3.fromRGB(235, 85, 85),
        TextSize         = 12,
        Font             = Enum.Font.GothamBold,
        AutoButtonColor  = false,
        BorderSizePixel  = 0,
        ZIndex           = 23,
        Parent           = card,
    })
    Corner(btnConfirm, 12)

    -- Hover
    btnCancel.MouseEnter:Connect(function()
        Tween(btnCancel, { BackgroundTransparency = 0.85 }, 0.1)
    end)
    btnCancel.MouseLeave:Connect(function()
        Tween(btnCancel, { BackgroundTransparency = 1 }, 0.1)
    end)
    btnConfirm.MouseEnter:Connect(function()
        Tween(btnConfirm, { BackgroundTransparency = 0.85 }, 0.1)
    end)
    btnConfirm.MouseLeave:Connect(function()
        Tween(btnConfirm, { BackgroundTransparency = 1 }, 0.1)
    end)

    -- Actions
    btnCancel.MouseButton1Click:Connect(function()
        overlay:Destroy()
    end)
    btnConfirm.MouseButton1Click:Connect(function()
        overlay:Destroy()
        self:Destroy()
    end)
end

-- Détruit toute l'UI
function Window:Destroy()
    self._gui:Destroy()
end

-- ═══════════════════════════════════════════════════
--  MODULE PRINCIPAL : Requiem
-- ═══════════════════════════════════════════════════
local Requiem = {}
Requiem.__index = Requiem

--[[
  Crée et retourne une fenêtre.

  @param config {
      Name            : string,
      Subtitle        : string,
      Icon            : number,   -- rbxassetid (optionnel)
      LoadingSettings : { Title:string, Subtitle:string },
      FileSettings    : { ConfigFolder:string },
  }
  @return Window
--]]
function Requiem:CreateWindow(config)
    return Window._new(config or {})
end

return Requiem
