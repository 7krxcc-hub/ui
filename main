local UILib = {}
UILib.__index = UILib

-- ══════════════════════════════════════════════
--  SERVICES
-- ══════════════════════════════════════════════
local Players          = game:GetService("Players")
local TweenService     = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui   = LocalPlayer:WaitForChild("PlayerGui")

-- ══════════════════════════════════════════════
--  THÈME PAR DÉFAUT
-- ══════════════════════════════════════════════
local DefaultTheme = {
    Background   = Color3.fromRGB(18,  18,  18),   -- fond fenêtre
    Sidebar      = Color3.fromRGB(26,  26,  26),   -- sidebar gauche
    TopBar       = Color3.fromRGB(22,  22,  22),   -- barre du haut
    Content      = Color3.fromRGB(15,  15,  15),   -- zone contenu
    ItemHover    = Color3.fromRGB(38,  38,  48),   -- survol nav
    ItemSelected = Color3.fromRGB(42,  42,  58),   -- sélectionné
    Accent       = Color3.fromRGB(110, 110, 220),  -- couleur accentuée
    AccentHover  = Color3.fromRGB(130, 130, 240),
    Border       = Color3.fromRGB(45,  45,  45),
    Text         = Color3.fromRGB(240, 240, 240),
    SubText      = Color3.fromRGB(140, 140, 145),
    SectionText  = Color3.fromRGB(100, 100, 105),
    Element      = Color3.fromRGB(30,  30,  35),
    ElementHover = Color3.fromRGB(40,  40,  50),
    ScrollBar    = Color3.fromRGB(60,  60,  70),
    Toggle_Off   = Color3.fromRGB(60,  60,  65),
    Toggle_On    = Color3.fromRGB(110, 110, 220),
    White        = Color3.fromRGB(255, 255, 255),
}

-- ══════════════════════════════════════════════
--  UTILITAIRES INTERNES
-- ══════════════════════════════════════════════

--- Crée une instance avec une table de propriétés.
local function New(class, props)
    local obj = Instance.new(class)
    for k, v in pairs(props) do
        if k ~= "Parent" then obj[k] = v end
    end
    if props.Parent then obj.Parent = props.Parent end
    return obj
end

--- Anime une instance vers les propriétés cibles.
local function Tween(obj, goal, duration, style)
    local info = TweenInfo.new(
        duration or 0.18,
        style    or Enum.EasingStyle.Quad,
        Enum.EasingDirection.Out
    )
    TweenService:Create(obj, info, goal):Play()
end

--- Ajoute un UICorner à un parent.
local function Corner(parent, radius)
    New("UICorner", { CornerRadius = UDim.new(0, radius or 8), Parent = parent })
end

--- Ajoute un UIStroke à un parent.
local function Stroke(parent, color, thickness)
    New("UIStroke", {
        Color     = color     or DefaultTheme.Border,
        Thickness = thickness or 1,
        Parent    = parent
    })
end

-- ══════════════════════════════════════════════
--  CONSTRUCTEUR DE FENÊTRE
-- ══════════════════════════════════════════════

---@param config table  {Title, Version, Theme, Size}
---@return UILib
function UILib.new(config)
    local self  = setmetatable({}, UILib)
    config      = config or {}

    self.Title   = config.Title   or "Mon Script"
    self.Version = config.Version or "v1.0"
    self.Theme   = setmetatable(config.Theme or {}, { __index = DefaultTheme })
    self.Size    = config.Size    or Vector2.new(760, 500)

    -- Tables internes
    self._sections    = {}   -- { name, label, tabs:[] }
    self._tabs        = {}   -- liste plate de tous les onglets
    self._currentTab  = nil

    self:_BuildWindow()
    return self
end

-- ══════════════════════════════════════════════
--  CONSTRUCTION DE LA FENÊTRE
-- ══════════════════════════════════════════════

function UILib:_BuildWindow()
    local T  = self.Theme
    local sx = self.Size.X
    local sy = self.Size.Y
    local sw = 210  -- largeur sidebar

    -- ScreenGui
    self._gui = New("ScreenGui", {
        Name            = "UILib_" .. self.Title,
        ResetOnSpawn    = false,
        ZIndexBehavior  = Enum.ZIndexBehavior.Sibling,
        Parent          = PlayerGui,
    })

    -- Fenêtre principale
    self._win = New("Frame", {
        Name              = "Window",
        Size              = UDim2.fromOffset(sx, sy),
        Position          = UDim2.new(0.5, -sx/2, 0.5, -sy/2),
        BackgroundColor3  = T.Background,
        BorderSizePixel   = 0,
        ClipsDescendants  = true,
        Parent            = self._gui,
    })
    Corner(self._win, 12)
    Stroke(self._win, T.Border, 1)

    -- Drag
    self:_MakeDraggable(self._win)

    -- ── Sidebar ─────────────────────────────────
    self._sidebar = New("Frame", {
        Name             = "Sidebar",
        Size             = UDim2.new(0, sw, 1, 0),
        BackgroundColor3 = T.Sidebar,
        BorderSizePixel  = 0,
        ZIndex           = 2,
        Parent           = self._win,
    })
    -- Coins droits plats (masquer arrondi côté intérieur)
    New("Frame", {
        Size             = UDim2.new(0, 12, 1, 0),
        Position         = UDim2.new(1, -12, 0, 0),
        BackgroundColor3 = T.Sidebar,
        BorderSizePixel  = 0,
        ZIndex           = 2,
        Parent           = self._sidebar,
    })
    Corner(self._sidebar, 12)

    -- Titre de la sidebar
    New("TextLabel", {
        Name             = "Title",
        Size             = UDim2.new(1, 0, 0, 52),
        BackgroundTransparency = 1,
        Text             = self.Title,
        TextColor3       = T.Text,
        TextSize         = 15,
        Font             = Enum.Font.GothamBold,
        TextXAlignment   = Enum.TextXAlignment.Center,
        ZIndex           = 3,
        Parent           = self._sidebar,
    })

    -- Séparateur sous le titre
    New("Frame", {
        Size             = UDim2.new(1, -24, 0, 1),
        Position         = UDim2.new(0, 12, 0, 52),
        BackgroundColor3 = T.Border,
        BorderSizePixel  = 0,
        ZIndex           = 3,
        Parent           = self._sidebar,
    })

    -- Zone de navigation (scrollable)
    self._navFrame = New("ScrollingFrame", {
        Name                = "Nav",
        Size                = UDim2.new(1, 0, 1, -110),
        Position            = UDim2.new(0, 0, 0, 55),
        BackgroundTransparency = 1,
        BorderSizePixel     = 0,
        ScrollBarThickness  = 3,
        ScrollBarImageColor3 = T.ScrollBar,
        CanvasSize          = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ZIndex              = 3,
        Parent              = self._sidebar,
    })
    New("UIListLayout", {
        SortOrder  = Enum.SortOrder.LayoutOrder,
        Padding    = UDim.new(0, 2),
        Parent     = self._navFrame,
    })
    New("UIPadding", {
        PaddingLeft  = UDim.new(0, 8),
        PaddingRight = UDim.new(0, 8),
        PaddingTop   = UDim.new(0, 4),
        Parent       = self._navFrame,
    })

    -- Infos utilisateur (bas sidebar)
    self:_BuildUserInfo()

    -- ── Top Bar ─────────────────────────────────
    self._topBar = New("Frame", {
        Name             = "TopBar",
        Size             = UDim2.new(1, -sw, 0, 44),
        Position         = UDim2.new(0, sw, 0, 0),
        BackgroundColor3 = T.TopBar,
        BorderSizePixel  = 0,
        ZIndex           = 2,
        Parent           = self._win,
    })
    -- Remplir coin arrondi côté gauche (jonction sidebar)
    New("Frame", {
        Size             = UDim2.new(0, 10, 1, 0),
        BackgroundColor3 = T.TopBar,
        BorderSizePixel  = 0,
        ZIndex           = 2,
        Parent           = self._topBar,
    })

    -- Version dans la topbar
    New("TextLabel", {
        Size                   = UDim2.new(0, 120, 1, 0),
        Position               = UDim2.new(0, 14, 0, 0),
        BackgroundTransparency = 1,
        Text                   = self.Version,
        TextColor3             = T.SubText,
        TextSize               = 12,
        Font                   = Enum.Font.Gotham,
        TextXAlignment         = Enum.TextXAlignment.Left,
        ZIndex                 = 3,
        Parent                 = self._topBar,
    })

    -- Boutons macOS (fermer / réduire / agrandir)
    local macColors = {
        { Color3.fromRGB(255, 96, 92),  function() self:Close() end },
        { Color3.fromRGB(255, 189, 46), function() self:Toggle() end },
        { Color3.fromRGB(39,  201, 63), nil },
    }
    for i, mac in ipairs(macColors) do
        local dot = New("TextButton", {
            Size             = UDim2.fromOffset(13, 13),
            Position         = UDim2.new(1, -(18 + (i-1)*20), 0.5, -6),
            BackgroundColor3 = mac[1],
            Text             = "",
            BorderSizePixel  = 0,
            ZIndex           = 4,
            Parent           = self._topBar,
        })
        Corner(dot, 100)
        if mac[2] then dot.MouseButton1Click:Connect(mac[2]) end
    end

    -- ── Zone de contenu ─────────────────────────
    self._content = New("Frame", {
        Name             = "Content",
        Size             = UDim2.new(1, -sw, 1, -44),
        Position         = UDim2.new(0, sw, 0, 44),
        BackgroundColor3 = T.Content,
        BorderSizePixel  = 0,
        ZIndex           = 1,
        Parent           = self._win,
    })
    -- Coins arrondis seulement en bas à droite
    Corner(self._content, 12)
    New("Frame", {
        Size             = UDim2.new(0, 12, 0, 12),
        BackgroundColor3 = T.Content,
        BorderSizePixel  = 0,
        ZIndex           = 1,
        Parent           = self._content,
    })
    New("Frame", {
        Size             = UDim2.new(0, 12, 0, 12),
        Position         = UDim2.new(1, -12, 0, 0),
        BackgroundColor3 = T.Content,
        BorderSizePixel  = 0,
        ZIndex           = 1,
        Parent           = self._content,
    })
end

-- ══════════════════════════════════════════════
--  INFO UTILISATEUR (BAS SIDEBAR)
-- ══════════════════════════════════════════════

function UILib:_BuildUserInfo()
    local T  = self.Theme
    local pl = LocalPlayer

    local frame = New("Frame", {
        Name             = "UserInfo",
        Size             = UDim2.new(1, 0, 0, 52),
        Position         = UDim2.new(0, 0, 1, -52),
        BackgroundTransparency = 1,
        ZIndex           = 3,
        Parent           = self._sidebar,
    })

    -- Séparateur
    New("Frame", {
        Size             = UDim2.new(1, -24, 0, 1),
        Position         = UDim2.new(0, 12, 0, 0),
        BackgroundColor3 = T.Border,
        BorderSizePixel  = 0,
        ZIndex           = 3,
        Parent           = frame,
    })

    -- Avatar container
    local avatarBg = New("Frame", {
        Size             = UDim2.fromOffset(34, 34),
        Position         = UDim2.new(0, 12, 0.5, -14),
        BackgroundColor3 = Color3.fromRGB(55, 55, 60),
        BorderSizePixel  = 0,
        ZIndex           = 4,
        Parent           = frame,
    })
    Corner(avatarBg, 100)

    local avatar = New("ImageLabel", {
        Size             = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Image            = "rbxthumb://type=AvatarHeadShot&id=" .. pl.UserId .. "&w=48&h=48",
        ZIndex           = 5,
        Parent           = avatarBg,
    })
    Corner(avatar, 100)

    -- Nom et @handle
    New("TextLabel", {
        Size             = UDim2.new(1, -58, 0, 17),
        Position         = UDim2.new(0, 52, 0.5, -18),
        BackgroundTransparency = 1,
        Text             = pl.DisplayName or pl.Name,
        TextColor3       = T.Text,
        TextSize         = 12,
        Font             = Enum.Font.GothamBold,
        TextXAlignment   = Enum.TextXAlignment.Left,
        TextTruncate     = Enum.TextTruncate.AtEnd,
        ZIndex           = 4,
        Parent           = frame,
    })
    New("TextLabel", {
        Size             = UDim2.new(1, -58, 0, 14),
        Position         = UDim2.new(0, 52, 0.5, 2),
        BackgroundTransparency = 1,
        Text             = "@" .. pl.Name,
        TextColor3       = T.SectionText,
        TextSize         = 11,
        Font             = Enum.Font.Gotham,
        TextXAlignment   = Enum.TextXAlignment.Left,
        TextTruncate     = Enum.TextTruncate.AtEnd,
        ZIndex           = 4,
        Parent           = frame,
    })
end

-- ══════════════════════════════════════════════
--  DRAG (déplacer la fenêtre)
-- ══════════════════════════════════════════════

function UILib:_MakeDraggable(frame)
    local dragging, dragStart, startPos

    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging  = true
            dragStart = input.Position
            startPos  = frame.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local d = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale,  startPos.X.Offset + d.X,
                startPos.Y.Scale,  startPos.Y.Offset + d.Y
            )
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
end

-- ══════════════════════════════════════════════
--  SECTIONS & ONGLETS
-- ══════════════════════════════════════════════

---Crée une section (titre grisé) dans la sidebar.
---@param name string
---@return table section
function UILib:AddSection(name)
    local T   = self.Theme
    local sec = { name = name, tabs = {}, _order = #self._sections * 100 }

    local label = New("TextLabel", {
        Name                   = "Sec_" .. name,
        Size                   = UDim2.new(1, 0, 0, 28),
        BackgroundTransparency = 1,
        Text                   = string.upper(name),
        TextColor3             = T.SectionText,
        TextSize               = 10,
        Font                   = Enum.Font.GothamBold,
        TextXAlignment         = Enum.TextXAlignment.Left,
        LayoutOrder            = sec._order,
        ZIndex                 = 3,
        Parent                 = self._navFrame,
    })
    New("UIPadding", {
        PaddingLeft = UDim.new(0, 6),
        PaddingTop  = UDim.new(0, 6),
        Parent      = label,
    })

    sec._label = label
    table.insert(self._sections, sec)
    return sec
end

---Ajoute un onglet à une section.
---@param section table   retour de AddSection()
---@param name    string
---@param icon    string? rbxassetid://… (optionnel)
---@return table tab
function UILib:AddTab(section, name, icon)
    local T       = self.Theme
    local tabIdx  = #self._tabs + 1
    local secIdx  = section._order + #section.tabs + 1

    -- Page de contenu (ScrollingFrame)
    local page = New("ScrollingFrame", {
        Name                = "Page_" .. name,
        Size                = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel     = 0,
        ScrollBarThickness  = 3,
        ScrollBarImageColor3 = T.ScrollBar,
        CanvasSize          = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible             = false,
        ZIndex              = 2,
        Parent              = self._content,
    })
    New("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding   = UDim.new(0, 8),
        Parent    = page,
    })
    New("UIPadding", {
        PaddingTop    = UDim.new(0, 14),
        PaddingBottom = UDim.new(0, 14),
        PaddingLeft   = UDim.new(0, 14),
        PaddingRight  = UDim.new(0, 14),
        Parent        = page,
    })

    -- Bouton nav
    local btn = New("TextButton", {
        Name             = "Nav_" .. name,
        Size             = UDim2.new(1, 0, 0, 34),
        BackgroundColor3 = T.ItemSelected,
        BackgroundTransparency = 1,
        Text             = "",
        BorderSizePixel  = 0,
        AutoButtonColor  = false,
        LayoutOrder      = secIdx,
        ZIndex           = 3,
        Parent           = self._navFrame,
    })
    Corner(btn, 7)

    -- Icône (optionnelle)
    local xOffset = 10
    if icon then
        New("ImageLabel", {
            Size             = UDim2.fromOffset(16, 16),
            Position         = UDim2.new(0, 10, 0.5, -8),
            BackgroundTransparency = 1,
            Image            = icon,
            ImageColor3      = T.SubText,
            ZIndex           = 4,
            Parent           = btn,
        })
        xOffset = 32
    end

    -- Texte de l'onglet
    local lbl = New("TextLabel", {
        Size                   = UDim2.new(1, -(xOffset + 8), 1, 0),
        Position               = UDim2.new(0, xOffset, 0, 0),
        BackgroundTransparency = 1,
        Text                   = name,
        TextColor3             = T.SubText,
        TextSize               = 13,
        Font                   = Enum.Font.Gotham,
        TextXAlignment         = Enum.TextXAlignment.Left,
        ZIndex                 = 4,
        Parent                 = btn,
    })

    local tab = {
        name   = name,
        page   = page,
        button = btn,
        label  = lbl,
    }

    -- Interactions
    btn.MouseButton1Click:Connect(function() self:SelectTab(tab) end)
    btn.MouseEnter:Connect(function()
        if self._currentTab ~= tab then
            Tween(btn, { BackgroundTransparency = 0.85 }, 0.12)
        end
    end)
    btn.MouseLeave:Connect(function()
        if self._currentTab ~= tab then
            Tween(btn, { BackgroundTransparency = 1 }, 0.12)
        end
    end)

    table.insert(section.tabs, tab)
    table.insert(self._tabs, tab)

    -- Sélection automatique du premier onglet
    if #self._tabs == 1 then self:SelectTab(tab) end

    return tab
end

---Sélectionne un onglet et affiche sa page.
function UILib:SelectTab(tab)
    local T = self.Theme

    if self._currentTab then
        self._currentTab.page.Visible = false
        Tween(self._currentTab.button, { BackgroundTransparency = 1 }, 0.12)
        self._currentTab.label.TextColor3 = T.SubText
        self._currentTab.label.Font       = Enum.Font.Gotham
    end

    self._currentTab          = tab
    tab.page.Visible          = true
    Tween(tab.button, { BackgroundTransparency = 0 }, 0.12)
    tab.label.TextColor3      = T.Text
    tab.label.Font            = Enum.Font.GothamBold
end

-- ══════════════════════════════════════════════
--  ÉLÉMENTS UI  (ajoutés dans les onglets)
-- ══════════════════════════════════════════════

--- Ajoute un label simple.
---@param tab  table
---@param text string
function UILib:AddLabel(tab, text)
    local T   = self.Theme
    local lbl = New("TextLabel", {
        Name                   = "Label",
        Size                   = UDim2.new(1, 0, 0, 24),
        BackgroundTransparency = 1,
        Text                   = text or "",
        TextColor3             = T.SubText,
        TextSize               = 12,
        Font                   = Enum.Font.Gotham,
        TextXAlignment         = Enum.TextXAlignment.Left,
        TextWrapped            = true,
        ZIndex                 = 3,
        Parent                 = tab.page,
    })
    New("UIPadding", { PaddingLeft = UDim.new(0, 4), Parent = lbl })
    return lbl
end

--- Ajoute un bouton cliquable.
---@param tab    table
---@param config { Text:string, Callback:function }
function UILib:AddButton(tab, config)
    local T   = self.Theme
    config    = config or {}

    local btn = New("TextButton", {
        Name             = "Btn_" .. (config.Text or "Bouton"),
        Size             = UDim2.new(1, 0, 0, 36),
        BackgroundColor3 = T.Element,
        Text             = config.Text or "Bouton",
        TextColor3       = T.Text,
        TextSize         = 13,
        Font             = Enum.Font.Gotham,
        AutoButtonColor  = false,
        BorderSizePixel  = 0,
        ZIndex           = 3,
        Parent           = tab.page,
    })
    Corner(btn, 7)
    Stroke(btn, T.Border, 1)

    btn.MouseButton1Click:Connect(function()
        Tween(btn, { BackgroundColor3 = T.Accent }, 0.08)
        task.delay(0.12, function() Tween(btn, { BackgroundColor3 = T.Element }, 0.15) end)
        if config.Callback then config.Callback() end
    end)
    btn.MouseEnter:Connect(function()
        Tween(btn, { BackgroundColor3 = T.ElementHover }, 0.12)
    end)
    btn.MouseLeave:Connect(function()
        Tween(btn, { BackgroundColor3 = T.Element }, 0.12)
    end)

    return btn
end

--- Ajoute un toggle ON/OFF.
---@param tab    table
---@param config { Text:string, Default:boolean, Callback:function }
function UILib:AddToggle(tab, config)
    local T      = self.Theme
    config       = config or {}
    local state  = config.Default == true

    local row = New("Frame", {
        Name             = "Toggle_" .. (config.Text or "Toggle"),
        Size             = UDim2.new(1, 0, 0, 38),
        BackgroundColor3 = T.Element,
        BorderSizePixel  = 0,
        ZIndex           = 3,
        Parent           = tab.page,
    })
    Corner(row, 7)
    Stroke(row, T.Border, 1)

    New("TextLabel", {
        Size                   = UDim2.new(1, -60, 1, 0),
        Position               = UDim2.new(0, 12, 0, 0),
        BackgroundTransparency = 1,
        Text                   = config.Text or "Toggle",
        TextColor3             = T.Text,
        TextSize               = 13,
        Font                   = Enum.Font.Gotham,
        TextXAlignment         = Enum.TextXAlignment.Left,
        ZIndex                 = 4,
        Parent                 = row,
    })

    -- Fond du switch
    local track = New("Frame", {
        Size             = UDim2.fromOffset(38, 22),
        Position         = UDim2.new(1, -48, 0.5, -11),
        BackgroundColor3 = state and T.Toggle_On or T.Toggle_Off,
        BorderSizePixel  = 0,
        ZIndex           = 4,
        Parent           = row,
    })
    Corner(track, 100)

    -- Knob
    local knob = New("Frame", {
        Size             = UDim2.fromOffset(16, 16),
        Position         = state and UDim2.new(0, 19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8),
        BackgroundColor3 = T.White,
        BorderSizePixel  = 0,
        ZIndex           = 5,
        Parent           = track,
    })
    Corner(knob, 100)

    -- Zone cliquable transparente
    local hitbox = New("TextButton", {
        Size             = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text             = "",
        ZIndex           = 6,
        Parent           = row,
    })

    hitbox.MouseButton1Click:Connect(function()
        state = not state
        Tween(track, { BackgroundColor3 = state and T.Toggle_On or T.Toggle_Off }, 0.15)
        Tween(knob,  { Position = state and UDim2.new(0, 19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8) }, 0.15)
        if config.Callback then config.Callback(state) end
    end)

    --- Accès programmatique
    return {
        frame    = row,
        GetState = function() return state end,
        SetState = function(v)
            state = v
            Tween(track, { BackgroundColor3 = state and T.Toggle_On or T.Toggle_Off }, 0.15)
            Tween(knob,  { Position = state and UDim2.new(0, 19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8) }, 0.15)
        end,
    }
end

--- Ajoute un slider.
---@param tab    table
---@param config { Text:string, Min:number, Max:number, Default:number, Callback:function }
function UILib:AddSlider(tab, config)
    local T      = self.Theme
    config       = config or {}
    local min    = config.Min     or 0
    local max    = config.Max     or 100
    local value  = config.Default or min
    local step   = config.Step    or 1

    local row = New("Frame", {
        Name             = "Slider_" .. (config.Text or "Slider"),
        Size             = UDim2.new(1, 0, 0, 54),
        BackgroundColor3 = T.Element,
        BorderSizePixel  = 0,
        ZIndex           = 3,
        Parent           = tab.page,
    })
    Corner(row, 7)
    Stroke(row, T.Border, 1)

    New("TextLabel", {
        Size                   = UDim2.new(0.65, 0, 0, 22),
        Position               = UDim2.new(0, 12, 0, 7),
        BackgroundTransparency = 1,
        Text                   = config.Text or "Slider",
        TextColor3             = T.Text,
        TextSize               = 13,
        Font                   = Enum.Font.Gotham,
        TextXAlignment         = Enum.TextXAlignment.Left,
        ZIndex                 = 4,
        Parent                 = row,
    })

    local valLbl = New("TextLabel", {
        Size                   = UDim2.new(0.35, -14, 0, 22),
        Position               = UDim2.new(0.65, 0, 0, 7),
        BackgroundTransparency = 1,
        Text                   = tostring(value),
        TextColor3             = T.SubText,
        TextSize               = 12,
        Font                   = Enum.Font.GothamBold,
        TextXAlignment         = Enum.TextXAlignment.Right,
        ZIndex                 = 4,
        Parent                 = row,
    })

    -- Track
    local track = New("Frame", {
        Size             = UDim2.new(1, -24, 0, 5),
        Position         = UDim2.new(0, 12, 0, 37),
        BackgroundColor3 = T.Border,
        BorderSizePixel  = 0,
        ZIndex           = 4,
        Parent           = row,
    })
    Corner(track, 100)

    -- Fill
    local fill = New("Frame", {
        Size             = UDim2.new((value - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = T.Accent,
        BorderSizePixel  = 0,
        ZIndex           = 5,
        Parent           = track,
    })
    Corner(fill, 100)

    -- Knob du slider
    local sliderKnob = New("Frame", {
        Size             = UDim2.fromOffset(14, 14),
        AnchorPoint      = Vector2.new(0.5, 0.5),
        Position         = UDim2.new((value - min) / (max - min), 0, 0.5, 0),
        BackgroundColor3 = T.White,
        BorderSizePixel  = 0,
        ZIndex           = 6,
        Parent           = track,
    })
    Corner(sliderKnob, 100)

    local function SetValue(raw)
        local pct     = math.clamp((raw - min) / (max - min), 0, 1)
        value         = math.round((min + (max - min) * pct) / step) * step
        valLbl.Text   = tostring(value)
        Tween(fill,        { Size     = UDim2.new(pct, 0, 1, 0) }, 0.05)
        Tween(sliderKnob,  { Position = UDim2.new(pct, 0, 0.5, 0) }, 0.05)
        if config.Callback then config.Callback(value) end
    end

    -- Dragging
    local dragging = false
    track.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            local pct = math.clamp((inp.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            SetValue(min + (max - min) * pct)
        end
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if dragging and inp.UserInputType == Enum.UserInputType.MouseMovement then
            local pct = math.clamp((inp.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            SetValue(min + (max - min) * pct)
        end
    end)
    UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)

    return {
        frame    = row,
        GetValue = function() return value end,
        SetValue = SetValue,
    }
end

--- Ajoute un dropdown.
---@param tab    table
---@param config { Text:string, Options:table, Default:string, Callback:function }
function UILib:AddDropdown(tab, config)
    local T       = self.Theme
    config        = config or {}
    local options = config.Options or {}
    local current = config.Default or (options[1] or "Choisir...")
    local open    = false

    local container = New("Frame", {
        Name             = "DD_" .. (config.Text or "Dropdown"),
        Size             = UDim2.new(1, 0, 0, 38),
        BackgroundTransparency = 1,
        ZIndex           = 5,
        Parent           = tab.page,
        ClipsDescendants = false,
    })

    local row = New("Frame", {
        Size             = UDim2.new(1, 0, 0, 38),
        BackgroundColor3 = T.Element,
        BorderSizePixel  = 0,
        ZIndex           = 5,
        Parent           = container,
    })
    Corner(row, 7)
    Stroke(row, T.Border, 1)

    New("TextLabel", {
        Size                   = UDim2.new(0, 120, 1, 0),
        Position               = UDim2.new(0, 12, 0, 0),
        BackgroundTransparency = 1,
        Text                   = config.Text or "Dropdown",
        TextColor3             = T.Text,
        TextSize               = 13,
        Font                   = Enum.Font.Gotham,
        TextXAlignment         = Enum.TextXAlignment.Left,
        ZIndex                 = 6,
        Parent                 = row,
    })

    local valLbl = New("TextLabel", {
        Size                   = UDim2.new(1, -130, 1, 0),
        Position               = UDim2.new(0, 120, 0, 0),
        BackgroundTransparency = 1,
        Text                   = current,
        TextColor3             = T.Accent,
        TextSize               = 12,
        Font                   = Enum.Font.GothamBold,
        TextXAlignment         = Enum.TextXAlignment.Right,
        ZIndex                 = 6,
        Parent                 = row,
    })
    New("UIPadding", { PaddingRight = UDim.new(0, 12), Parent = valLbl })

    -- Liste déroulante
    local list = New("Frame", {
        Size             = UDim2.new(1, 0, 0, #options * 32 + 6),
        Position         = UDim2.new(0, 0, 1, 4),
        BackgroundColor3 = T.Element,
        BorderSizePixel  = 0,
        Visible          = false,
        ZIndex           = 8,
        Parent           = container,
    })
    Corner(list, 7)
    Stroke(list, T.Border, 1)

    New("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })
    New("UIPadding", { PaddingTop = UDim.new(0, 3), PaddingBottom = UDim.new(0, 3), Parent = list })

    for _, opt in ipairs(options) do
        local item = New("TextButton", {
            Size             = UDim2.new(1, 0, 0, 32),
            BackgroundColor3 = T.Element,
            BackgroundTransparency = 1,
            Text             = opt,
            TextColor3       = opt == current and T.Text or T.SubText,
            TextSize         = 12,
            Font             = opt == current and Enum.Font.GothamBold or Enum.Font.Gotham,
            AutoButtonColor  = false,
            ZIndex           = 9,
            Parent           = list,
        })
        New("UIPadding", { PaddingLeft = UDim.new(0, 12), Parent = item })

        item.MouseEnter:Connect(function()
            Tween(item, { BackgroundTransparency = 0.85 }, 0.1)
        end)
        item.MouseLeave:Connect(function()
            Tween(item, { BackgroundTransparency = 1 }, 0.1)
        end)
        item.MouseButton1Click:Connect(function()
            current       = opt
            valLbl.Text   = opt
            list.Visible  = false
            open          = false
            if config.Callback then config.Callback(opt) end
        end)
    end

    local hitbox = New("TextButton", {
        Size             = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text             = "",
        ZIndex           = 7,
        Parent           = row,
    })
    hitbox.MouseButton1Click:Connect(function()
        open         = not open
        list.Visible = open
    end)

    return {
        frame      = container,
        GetValue   = function() return current end,
    }
end

--- Ajoute un séparateur visuel.
function UILib:AddSeparator(tab)
    local T = self.Theme
    New("Frame", {
        Name             = "Separator",
        Size             = UDim2.new(1, 0, 0, 1),
        BackgroundColor3 = T.Border,
        BorderSizePixel  = 0,
        ZIndex           = 3,
        Parent           = tab.page,
    })
end

--- Ajoute un champ de texte.
---@param tab    table
---@param config { Text:string, Placeholder:string, Callback:function }
function UILib:AddTextBox(tab, config)
    local T   = self.Theme
    config    = config or {}

    local row = New("Frame", {
        Name             = "TextBox_" .. (config.Text or "TextBox"),
        Size             = UDim2.new(1, 0, 0, 38),
        BackgroundColor3 = T.Element,
        BorderSizePixel  = 0,
        ZIndex           = 3,
        Parent           = tab.page,
    })
    Corner(row, 7)
    Stroke(row, T.Border, 1)

    New("TextLabel", {
        Size                   = UDim2.new(0.4, 0, 1, 0),
        Position               = UDim2.new(0, 12, 0, 0),
        BackgroundTransparency = 1,
        Text                   = config.Text or "Texte",
        TextColor3             = T.Text,
        TextSize               = 13,
        Font                   = Enum.Font.Gotham,
        TextXAlignment         = Enum.TextXAlignment.Left,
        ZIndex                 = 4,
        Parent                 = row,
    })

    local box = New("TextBox", {
        Size                   = UDim2.new(0.58, -12, 0, 24),
        Position               = UDim2.new(0.42, 0, 0.5, -12),
        BackgroundColor3       = T.Background,
        Text                   = "",
        PlaceholderText        = config.Placeholder or "...",
        TextColor3             = T.Text,
        PlaceholderColor3      = T.SectionText,
        TextSize               = 12,
        Font                   = Enum.Font.Gotham,
        ClearTextOnFocus       = false,
        BorderSizePixel        = 0,
        ZIndex                 = 4,
        Parent                 = row,
    })
    Corner(box, 5)
    New("UIPadding", { PaddingLeft = UDim.new(0, 6), Parent = box })

    box.FocusLost:Connect(function(enter)
        if enter and config.Callback then config.Callback(box.Text) end
    end)

    return {
        frame    = row,
        box      = box,
        GetText  = function() return box.Text end,
        SetText  = function(t) box.Text = t end,
    }
end

-- ══════════════════════════════════════════════
--  CONTRÔLE DE LA FENÊTRE
-- ══════════════════════════════════════════════

---Affiche ou cache la fenêtre.
function UILib:Toggle()
    self._win.Visible = not self._win.Visible
end

---Détruit complètement la fenêtre.
function UILib:Close()
    self._gui:Destroy()
end

---Change la touche pour afficher/cacher (défaut : RightShift).
---@param key Enum.KeyCode
function UILib:SetToggleKey(key)
    UserInputService.InputBegan:Connect(function(inp, gpe)
        if not gpe and inp.KeyCode == key then self:Toggle() end
    end)
end

return UILib
